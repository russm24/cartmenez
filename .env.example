# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
# low = snappiest replies; raise to medium/high if the banter feels thin
CLAUDE_EFFORT=low

# --- Camera ---
CAMERA_INDEX=0
# consecutive detection frames before we count someone as "arrived"
ARRIVE_FRAMES=5
# seconds with no detection before we count them as "gone"
LEAVE_SECONDS=4
# seconds to wait after a visitor leaves before greeting the next one
COOLDOWN_SECONDS=8

# --- Speech-to-text: google (free, online) | whisper (offline, needs faster-whisper) ---
STT_BACKEND=google
WHISPER_MODEL=base.en
LISTEN_TIMEOUT=6
PHRASE_LIMIT=12

# --- Text-to-speech: pyttsx3 (offline) | elevenlabs ---
TTS_BACKEND=pyttsx3
# pitch shift in semitones applied to pyttsx3 output (bratty-kid register)
TTS_PITCH_SEMITONES=4
TTS_RATE=185
# ElevenLabs: use a voice you created/own in your ElevenLabs Voice Library
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5

SOUNDS_DIR=sounds
MAX_TURNS=8
